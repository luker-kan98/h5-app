# Copy this file to backend/.env.production and replace every placeholder before
# reloading backend/celery/scheduler launchd services.

SECRET_KEY=replace-with-random-secret
DATABASE_URL=postgresql+psycopg://h5app:replace-this-password@127.0.0.1:5432/h5app
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
BUILDS_DIR=/Users/ec2-user/h5-app/builds
REPO_ROOT=/Users/ec2-user/h5-app
JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
SCHEDULER_INTERVAL_SECONDS=2

# --- S3 artifact upload (all four required to enable S3 download links) ---
S3_BUCKET_NAME=replace-with-bucket-name
S3_REGION=replace-with-region
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
# Optional:
# S3_PUBLIC_BASE_URL=https://cdn.example.com   # custom/CDN domain for download URLs
# S3_UPLOAD_PREFIX=uploads                      # key prefix (default: uploads)
# S3_OBJECT_ACL=public-read                     # set if bucket requires per-object ACL
# S3_ENDPOINT_URL=                              # for non-AWS S3 (R2/MinIO/etc.)
# S3_SESSION_TOKEN=                             # for temporary credentials
